<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#72C7FF</item>
        <item name="android:buttonStyle">@style/BlueButton</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#07090D</item>
        <item name="android:statusBarColor">#07090D</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="BlueButton" parent="android:style/Widget.Material.Button">
        <item name="android:backgroundTint">#54B9FF</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
